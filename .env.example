# ==========================================
# FormerBench Backend Environment Variables (Example)
# ==========================================

# PostgreSQL Database Configuration (Used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_unique_db_password
POSTGRES_DB=formerbench
POSTGRES_PORT=5432

# Backend API Configuration
NODE_ENV=development
PORT=5000

# Database URL
# For running Node.js backend locally outside Docker (connecting to Docker PostgreSQL):
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_unique_db_password@localhost:5432/formerbench?schema=public

# Security & Authentication
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Comma-separated origins for Vite frontend development)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Frontend Web Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_UPLOADS_BASE_URL=http://localhost:5000/uploads
VITE_SOCKET_URL=http://localhost:5000

# ==========================================
# Google SMTP Email Service
# ==========================================
# Use a Google App Password; never use the normal account password.
GOOGLE_SMTP_EMAIL=your_email@gmail.com
GOOGLE_SMTP_APP_PASSWORD=your_16_character_app_password
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=587
ORDER_NOTIFICATION_ADMIN_EMAIL=admin@example.com
FRONTEND_URL=http://localhost:3000

# ==========================================
# OTP Verification Rules
# ==========================================
OTP_EXPIRY_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ==========================================
# Razorpay Payment Gateway (Test Mode)
# ==========================================
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# Used only to verify the raw request body sent by Razorpay webhooks.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Upload Directory
UPLOAD_DIR=uploads

# Daily Market Price API
MARKET_PRICE_API_KEY=your_market_price_api_key_here

# Postal Code API (keep the real key in .env only)
POSTAL_CODE_API_KEY=your_postal_code_api_key_here
POSTAL_CODE_API_RESOURCE_ID=04cbe4b1-2f2b-4c39-a1d5-1c2e28bc0e32

# AI Assistant Chatbot Configuration
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Google OAuth Web Client ID (same public ID used by the frontend)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# =====================================================================
# Security hardening (optional)
# =====================================================================
# Which reverse proxies may set X-Forwarded-For (Express "trust proxy").
# Default trusts only loopback/private-network proxies (Nginx on same host, Docker bridge).
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Development only: print OTP codes / simulated emails to the console. Never enable in production.
# LOG_OTP_TO_CONSOLE=false

# docker-compose published-port bind addresses (default 127.0.0.1 = not internet-reachable)
# POSTGRES_BIND_ADDRESS=127.0.0.1
# API_BIND_ADDRESS=127.0.0.1

# Abuse limits (0 = unlimited)
# COUPON_MAX_USES_PER_USER=0
# MAX_OPEN_COD_ORDERS=10
# AI_DAILY_REQUEST_LIMIT=2000

# Seeding (npm run db:seed). Without SEED_ADMIN_PASSWORD a random one is generated and printed once.
# The seed refuses to run with NODE_ENV=production unless ALLOW_PRODUCTION_SEED=true (it wipes data!).
# SEED_ADMIN_EMAIL=admin@agriera.in
# SEED_ADMIN_PASSWORD=

# Emergency override only: lets production start with a placeholder/public JWT_SECRET. Do not use.
# ALLOW_INSECURE_JWT_SECRET=false
