# ==========================================
# FormerBench Backend Environment Variables (Example)
# ==========================================

# PostgreSQL Database Configuration (Used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=formerbench
POSTGRES_PORT=5432

# Backend API Configuration
NODE_ENV=development
PORT=5000

# Database URL
# For running Node.js backend locally outside Docker (connecting to Docker PostgreSQL):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formerbench?schema=public

# Security & Authentication
JWT_SECRET=development_jwt_secret_key_must_be_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000

# Frontend Web Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
