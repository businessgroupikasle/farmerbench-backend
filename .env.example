# ==========================================
# FormerBench Backend Environment Variables (Example)
# ==========================================

# PostgreSQL Database Configuration (Used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=formerbench
POSTGRES_PORT=5432

# Backend API Configuration
NODE_ENV=development
PORT=5000

# Database URL
# For running Node.js backend locally outside Docker (connecting to Docker PostgreSQL):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formerbench?schema=public

# Security & Authentication
JWT_SECRET=development_jwt_secret_key_must_be_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Comma-separated origins for Vite frontend development)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Frontend Web Configuration (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_UPLOADS_BASE_URL=http://localhost:5000/uploads
VITE_SOCKET_URL=http://localhost:5000

# ==========================================
# Nodemailer SMTP Email Service
# ==========================================
# Provide your real Gmail App Password or SMTP credentials to send actual emails.
# If left empty, the backend operates in Dev-Log Mode (OTPs & emails are logged to console & simulated).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM="FarmerBench Agri" <support@farmerbench.dev>
SMTP_SECURE=false

# ==========================================
# OTP Verification Rules
# ==========================================
OTP_EXPIRY_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ==========================================
# Razorpay Payment Gateway (Test Mode)
# ==========================================
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=rzp_test_your_secret_here
# Used only to verify the raw request body sent by Razorpay webhooks.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Upload Directory
UPLOAD_DIR=uploads
